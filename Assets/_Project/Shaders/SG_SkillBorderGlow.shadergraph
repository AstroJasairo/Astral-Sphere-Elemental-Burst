{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "93a92ab482a64aa0b7347064a6b4dcbf",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "PerimeterBands (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -556.7999877929688,
            "y": 442.4000244140625,
            "width": 246.39996337890626,
            "height": 213.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "b8524c62a0b6401b971ac7f47e026a8c"
        },
        {
            "m_Id": "038cecf92fb24d6296c4a4e5e61ce964"
        },
        {
            "m_Id": "72feb716941c4b48b53a546d8b5ae475"
        },
        {
            "m_Id": "ee62bd461cee41fc914581b179736249"
        },
        {
            "m_Id": "7e2dcb1ceebc473f96fc213466e99748"
        },
        {
            "m_Id": "ddecb7417ce749a19f3b29501e23ea62"
        },
        {
            "m_Id": "d571b999812b4be899936ca84aa27e33"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PerimeterBands",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 1) Đưa UV về khung 0..1 của riêng sprite (sprite thuộc sprite sheet Multiple có UV là vùng con)\r\nfloat2 size = max(UVRect.zw - UVRect.xy, 1e-5);\r\nfloat2 c = (InUV - UVRect.xy) / size - 0.5;        // tọa độ tính từ tâm nút: -0.5 .. 0.5\r\n\r\nfloat ax = abs(c.x);\r\nfloat ay = abs(c.y);\r\n\r\n// 2) Khoảng cách từ pixel tới mép gần nhất (0 tại mép, tăng dần vào trong) => mặt nạ vòng viền\r\nfloat edgeDist = 0.5 - max(ax, ay);\r\nfloat soft = max(Softness, 1e-4);\r\nfloat ring = 1.0 - smoothstep(BorderWidth - soft, BorderWidth, edgeDist);\r\n\r\n// 3) Vị trí dọc chu vi t = 0..1, thuận chiều kim đồng hồ, bắt đầu từ góc trên trái\r\n//    Mỗi cạnh chiếm 0.25 nên tốc độ chạy đều trên cả bốn cạnh\r\nfloat t;\r\nif (ay >= ax)\r\n    t = (c.y >= 0.0) ? (c.x + 0.5) * 0.25                 // cạnh trên: trái -> phải\r\n                     : 0.5 + (0.5 - c.x) * 0.25;          // cạnh dưới: phải -> trái\r\nelse\r\n    t = (c.x >= 0.0) ? 0.25 + (0.5 - c.y) * 0.25          // cạnh phải: trên -> dưới\r\n                     : 0.75 + (c.y + 0.5) * 0.25;         // cạnh trái: dưới -> trên\r\n\r\n// 4) Hai dải kiểu sao chổi: đầu tại Phase, đuôi mờ dần phía sau; dải thứ hai lệch nửa vòng\r\nfloat width = max(BandWidth, 1e-4);\r\nfloat b1 = saturate(1.0 - frac(Phase - t) / width);\r\nfloat b2 = saturate(1.0 - frac(Phase + 0.5 - t) / width);\r\nfloat band = pow(max(b1, b2), 2.0);                       // bình phương cho đuôi mờ tự nhiên\r\n\r\nOut = ring * band;"
}

